#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties

# Environment files (contain secrets)
.env.dev
.env.prod
.env

# Supabase functions local secrets
supabase/.env
supabase/.temp/

# Firebase service account keys
*-firebase-adminsdk-*.json

# Local source video files are too large for normal Git history.
assets/VIdeos/1 Moro/*.MOV
assets/VIdeos/moro/*.mov
.worktrees/
.env.staging
!docs/evidence/**/*.log
