SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
REVENUECAT_API_KEY=placeholder_revenuecat_key
ENVIRONMENT=development

# ADMIN_EMAIL: obsolet seit 2026-07 — der interne Tester-Gate prüft die
# E-Mail-Domain (@reflexjourney.de, Commit 1077e02); Variable wird nicht
# mehr gelesen (T11).
# TRAINER_CODE: obsolet seit server-seitiger Trainer-Aktivierung
# (activate-trainer prüft trainer_invite_codes); Variable wird nicht mehr
# gelesen (T11).

# Sentry-Crash-Reporting (T15): leer/weggelassen = Sentry AUS (Standard in
# Dev — kein Rauschen). Zum Testen den EU-DSN aus dem Sentry-Projekt
# eintragen; in .env.prod trägt der Founder den DSN lokal ein (nie committen).
# SENTRY_DSN=

# Social login (T26): non-secret OAuth Web Client ID used by google_sign_in
# as serverClientId for backend token exchange.
# GOOGLE_WEB_CLIENT_ID=
#
# iOS requires its own OAuth iOS Client ID (CLIENT_ID from GoogleService-Info).
# Keep empty unless Google provider setup is complete.
# GOOGLE_IOS_CLIENT_ID=
