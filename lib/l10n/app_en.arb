  "entryPointsTitle": "Many Paths Lead Here",
  "@entryPointsTitle": {"description": "Onboarding entry-points screen: headline"},
  "entryPointsSubtitle": "Reflex integration matters to very different people. See what sounds like you.",
  "@entryPointsSubtitle": {"description": "Onboarding entry-points screen: intro below headline"},
  "entryPointsChipQuestion": "What sounds familiar to you? (optional, choose any)",
  "@entryPointsChipQuestion": {"description": "Label above the multi-select chips"},
  "entryPointsSelectionNote": "Your selection doesn't change your training — it helps us understand who uses the app.",
  "@entryPointsSelectionNote": {"description": "Note under the chips explaining the selection has no training effect"},
  "entryPointsShowMore": "More",
  "@entryPointsShowMore": {"description": "Expand toggle on an area card (arrow appended in code)"},
  "entryPointsShowLess": "Less",
  "@entryPointsShowLess": {"description": "Collapse toggle on an area card (arrow appended in code)"},
  "entryPointsBodyTitle": "Body & Tension",
  "@entryPointsBodyTitle": {"description": "Area card: body/tension entry point — title"},
  "entryPointsBodyTeaser": "Muscle tension, posture patterns, a therapist's recommendation",
  "@entryPointsBodyTeaser": {"description": "Area card: body — one-line teaser"},
  "entryPointsBodyDetail": "Active reflex patterns can keep muscles in constant tension — independent of outside triggers. Physical and occupational therapists often recommend reflex integration exercises alongside their own work when recurring patterns don't fully release.\n\nTypical signs: chronic back or neck tension, jaw tension, posture patterns that keep coming back.",
  "@entryPointsBodyDetail": {"description": "Area card: body — expanded detail text"},
  "entryPointsBodyChip": "Body",
  "@entryPointsBodyChip": {"description": "Area card: body — chip label"},
  "entryPointsBodySource": "See Goddard Blythe: Reflexes, Learning and Behavior",
  "@entryPointsBodySource": {"description": "Area card: body — book citation (published edition titles per language)"},
  "entryPointsCoordinationTitle": "Coordination & Performance",
  "@entryPointsCoordinationTitle": {"description": "Area card: coordination/performance — title"},
  "entryPointsCoordinationTeaser": "Movement quality, balance, athletic coordination",
  "@entryPointsCoordinationTeaser": {"description": "Area card: coordination — one-line teaser"},
  "entryPointsCoordinationDetail": "Unintegrated reflexes tie up motor resources — which can show up as limited coordination, slower reactions, or balance difficulties. Athletes use reflex integration to move past coordination limits that regular training alone doesn't reach.\n\nTypical signs: movements feel harder than they should, asymmetries, balance under pressure.",
  "@entryPointsCoordinationDetail": {"description": "Area card: coordination — expanded detail text"},
  "entryPointsCoordinationChip": "Coordination",
  "@entryPointsCoordinationChip": {"description": "Area card: coordination — chip label"},
  "entryPointsCoordinationSource": "See Blomberg: Movements That Heal",
  "@entryPointsCoordinationSource": {"description": "Area card: coordination — book citation (published edition titles per language)"},
  "entryPointsEmotionTitle": "Emotional Regulation & Inner Life",
  "@entryPointsEmotionTitle": {"description": "Area card: emotional regulation — title"},
  "entryPointsEmotionTeaser": "Stress responses, sensory sensitivity, self-awareness",
  "@entryPointsEmotionTeaser": {"description": "Area card: emotional regulation — one-line teaser"},
  "entryPointsEmotionDetail": "Some reflex patterns directly influence how the nervous system responds to stimulation — stress sensitivity, emotional reactivity, sensory overload. Rhythmic movement can help the nervous system settle and open access to inner states.\n\nTypical signs: quick emotional flooding, difficulty winding down, body tension under stress. This varies greatly from person to person.",
  "@entryPointsEmotionDetail": {"description": "Area card: emotional regulation — expanded detail text"},
  "entryPointsEmotionChip": "Emotional Regulation",
  "@entryPointsEmotionChip": {"description": "Area card: emotional regulation — chip label"},
  "entryPointsEmotionSource": "See Blomberg: Movements That Heal",
  "@entryPointsEmotionSource": {"description": "Area card: emotional regulation — book citation"},
  "entryPointsChildTitle": "My Child: School & Development",
  "@entryPointsChildTitle": {"description": "Area card: my child — title"},
  "entryPointsChildTeaser": "Focus, learning, school — as a parent",
  "@entryPointsChildTeaser": {"description": "Area card: my child — one-line teaser"},
  "entryPointsChildDetail": "Early reflex patterns that were never fully integrated can show up later as difficulties with reading, writing, or concentration — often without a clear physical cause.\n\nTypical signs: your child struggles to keep up at school, finds it hard to focus, is restless in class, or finds fine motor tasks or reading a real effort.",
  "@entryPointsChildDetail": {"description": "Area card: my child — expanded detail text"},
  "entryPointsChildChip": "My Child",
  "@entryPointsChildChip": {"description": "Area card: my child — chip label"},
  "entryPointsChildSource": "See Goddard Blythe: Reflexes, Learning and Behavior",
  "@entryPointsChildSource": {"description": "Area card: my child — book citation"},
  "entryPointsCuriosityTitle": "Curiosity & Exploration",
  "@entryPointsCuriosityTitle": {"description": "Area card: curiosity — title"},
  "entryPointsCuriosityTeaser": "No specific concern — just exploring",
  "@entryPointsCuriosityTeaser": {"description": "Area card: curiosity — one-line teaser"},
  "entryPointsCuriosityDetail": "Some people arrive without a specific symptom — they've heard about reflex integration and are curious what several weeks of rhythmic movement will change. That is a completely valid way to start.\n\nYou don't need to name a \"problem\" to begin the training.",
  "@entryPointsCuriosityDetail": {"description": "Area card: curiosity — expanded detail text"},
  "entryPointsCuriosityChip": "Just Curious",
  "@entryPointsCuriosityChip": {"description": "Area card: curiosity — chip label"},

