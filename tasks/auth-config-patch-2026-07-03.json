  "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <title>E-Mail bestätigen · Confirm your email</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n\n  <!-- Preheader (hidden inbox preview text) -->\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">\n    Bestätige deine E-Mail, um loszulegen · Confirm your email to get started\n  </div>\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:#f5f5f5;padding:40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);max-width:560px;width:100%;\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#009E6B;padding:32px 40px;text-align:center;\">\n              <h1 style=\"margin:0;color:#ffffff;font-size:24px;font-weight:700;letter-spacing:0.5px;\">Reflex Journey</h1>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:40px 40px 20px;\">\n              <h2 style=\"margin:0 0 8px;font-size:20px;color:#009E6B;\">Willkommen bei Reflex Journey</h2>\n              <p style=\"margin:0 0 4px;font-size:13px;color:#888888;font-style:italic;\">Welcome to Reflex Journey</p>\n              <hr style=\"border:none;border-top:1px solid #eeeeee;margin:20px 0;\">\n\n              <p style=\"margin:0 0 12px;font-size:15px;color:#333333;line-height:1.6;\">\n                Schön, dass du dabei bist! Bestätige deine E-Mail-Adresse, um dein Konto zu aktivieren und loszulegen.\n              </p>\n              <p style=\"margin:0 0 28px;font-size:14px;color:#666666;line-height:1.6;font-style:italic;\">\n                Glad to have you! Confirm your email address to activate your account and get started.\n              </p>\n\n              <!-- CTA Button (Outlook-proof) -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom:24px;\">\n                    <!--[if mso]>\n                    <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://reflexjourney.app/auth/confirm?token_hash={{ .TokenHash }}&type=signup\" style=\"height:48px;v-text-anchor:middle;width:300px;\" arcsize=\"17%\" strokecolor=\"#009E6B\" fillcolor=\"#009E6B\">\n                    <w:anchorlock/>\n                    <center style=\"color:#ffffff;font-family:sans-serif;font-size:15px;font-weight:600;\">E-Mail bestätigen · Confirm email</center>\n                    </v:roundrect>\n                    <![endif]-->\n                    <!--[if !mso]><!-- -->\n                    <a href=\"https://reflexjourney.app/auth/confirm?token_hash={{ .TokenHash }}&type=signup\"\n                       style=\"display:inline-block;background-color:#009E6B;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;padding:14px 36px;border-radius:8px;letter-spacing:0.3px;\">\n                      E-Mail bestätigen &nbsp;·&nbsp; Confirm email\n                    </a>\n                    <!--<![endif]-->\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Copy-paste fallback link -->\n              <p style=\"margin:0 0 6px;font-size:12px;color:#888888;line-height:1.6;\">\n                Falls der Button nicht funktioniert, kopiere diesen Link in deinen Browser:<br>\n                <span style=\"font-style:italic;\">If the button doesn't work, copy this link into your browser:</span>\n              </p>\n              <p style=\"margin:0 0 28px;font-size:12px;color:#009E6B;line-height:1.5;word-break:break-all;\">\n                <a href=\"https://reflexjourney.app/auth/confirm?token_hash={{ .TokenHash }}&type=signup\" style=\"color:#009E6B;text-decoration:underline;\">https://reflexjourney.app/auth/confirm</a>\n              </p>\n\n              <p style=\"margin:0;font-size:12px;color:#aaaaaa;line-height:1.6;font-style:italic;\">\n                Wenn du dich nicht bei Reflex Journey registriert hast, kannst du diese Email ignorieren.<br>\n                If you didn't sign up for Reflex Journey, you can safely ignore this email.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:20px 40px 32px;\">\n              <hr style=\"border:none;border-top:1px solid #eeeeee;margin:0 0 20px;\">\n              <p style=\"margin:0;font-size:12px;color:#aaaaaa;text-align:center;line-height:1.6;\">\n                Reflex Journey · reflexjourney.de<br>\n                Diese Email wurde automatisch versandt · This email was sent automatically\n              </p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n"
